{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myvillagedecor-demo",
  "compatibility_date": "2026-08-19",
  "observability": {
    "enabled": true
  },
  "main": "worker.js",
  "assets": {
    "directory": "website",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "routes": [
    { "pattern": "myvillagedecor.legendwebsites.co.uk", "custom_domain": true }
  ]
}
